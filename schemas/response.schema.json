{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResponseEnvelope",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol": {
      "type": "string"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseBody"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/OperationStatus"
    }
  },
  "required": [
    "protocol",
    "status"
  ],
  "$defs": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^art-[0-9a-f]{32}$"
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "stdout",
        "stderr",
        "evidence",
        "snapshot_vmstate",
        "snapshot_memory",
        "snapshot_disk",
        "snapshot_manifest"
      ]
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "content_digest": {
          "description": "`sha256:<hex>`; present once the artifact is materialised.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "logical_name": {
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox_id": {
          "$ref": "#/$defs/SandboxId"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "source_operation_id": {
          "$ref": "#/$defs/OperationId"
        }
      },
      "required": [
        "artifact_id",
        "kind",
        "logical_name",
        "schema_version",
        "source_operation_id",
        "sandbox_id"
      ]
    },
    "BackendIdentity": {
      "description": "What this backend *is*, recorded in the runtime manifest and in every snapshot manifest\n(spec §17.4): a snapshot is only restorable by a backend with an equivalent identity.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "profile": {
          "description": "Human-auditable detail behind `security_profile_id`."
        },
        "security_profile_id": {
          "description": "Stable digest of the isolation profile (seccomp, cgroups, namespaces, uid policy, …).",
          "type": "string"
        },
        "version": {
          "description": "Exact VMM version, e.g. `v1.17.0`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "security_profile_id",
        "profile"
      ]
    },
    "CapabilityProfile": {
      "description": "Which semantic operations the backend supports. Unsupported ones must fail with a stable\n`UNSUPPORTED` result rather than being silently skipped (spec DELTA-018).",
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "guest_exec": {
          "type": "boolean"
        },
        "max_vcpus": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "network_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetworkMode"
          }
        },
        "pause_resume": {
          "type": "boolean"
        },
        "restore": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "boolean"
        }
      },
      "required": [
        "backend",
        "pause_resume",
        "snapshot",
        "restore",
        "guest_exec",
        "network_modes",
        "max_vcpus"
      ]
    },
    "ErrorBody": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/FailureClass"
        },
        "message": {
          "type": "string"
        },
        "outcome_unknown": {
          "description": "True when the outcome is genuinely unknown: resolve with `operation_get`, never re-run.",
          "type": "boolean"
        },
        "retryable": {
          "description": "True only when the failure is definite *and* worth retrying with the same operation id.",
          "type": "boolean"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect"
        }
      },
      "required": [
        "class",
        "message",
        "side_effect",
        "retryable",
        "outcome_unknown"
      ]
    },
    "EvidenceStatus": {
      "description": "Whether the evidence attached to a terminal result is whole (spec §23.4).",
      "type": "string",
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "TRUNCATED",
        "UNKNOWN"
      ]
    },
    "FailureClass": {
      "description": "Spec §14.1, plus three non-semantic additions the wire protocol needs.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "VALIDATION",
            "AUTHORIZATION",
            "STATE_CONFLICT",
            "ADMISSION_REJECTED",
            "RESOURCE_EXHAUSTION",
            "TIMEOUT_UNKNOWN",
            "BACKEND_UNAVAILABLE",
            "BACKEND_CRASH",
            "CORRUPT_INPUT",
            "SCHEMA_MISMATCH",
            "COMPATIBILITY_FAILURE",
            "PARTIAL_COMPLETION",
            "LOST_RESPONSE",
            "SECURITY_CONTROL_FAILURE",
            "EVIDENCE_INCOMPLETE",
            "OUTPUT_LIMIT",
            "RECOVERY_QUARANTINED",
            "NOT_FOUND",
            "INTERNAL"
          ]
        },
        {
          "description": "Stable capability result for operations a backend does not support (DELTA-018).",
          "type": "string",
          "const": "UNSUPPORTED"
        }
      ]
    },
    "FailureInfo": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/FailureClass"
        },
        "message": {
          "type": "string"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect"
        }
      },
      "required": [
        "class",
        "message",
        "side_effect"
      ]
    },
    "Generation": {
      "description": "Monotonic per-sandbox incarnation counter (spec §11.4). Starts at 1; never reused.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "backend": {
          "$ref": "#/$defs/BackendIdentity"
        },
        "capabilities": {
          "$ref": "#/$defs/CapabilityProfile"
        },
        "instance_id": {
          "type": "string"
        },
        "journal_integrity": {
          "type": "string"
        },
        "live_sandboxes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "mode": {
          "description": "`normal`, or `read_only_quarantine` when the journal failed its integrity check.",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/PolicyId"
        },
        "protocol": {
          "type": "string"
        },
        "snapshots": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "protocol",
        "instance_id",
        "mode",
        "backend",
        "capabilities",
        "policy",
        "journal_integrity",
        "live_sandboxes",
        "snapshots"
      ]
    },
    "ImageRef": {
      "description": "Immutable execution identity. The alias is a *mutable human label* and is never sufficient\non its own (spec §8.9): `image_id` is the digest of the image manifest.",
      "type": "object",
      "properties": {
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture": {
          "type": "string"
        },
        "image_id": {
          "description": "`sha256:<hex>` of the canonical image manifest.",
          "type": "string"
        },
        "kernel_identity": {
          "description": "`sha256:<hex>` of the kernel file's bytes.",
          "type": "string"
        },
        "manifest_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "provenance_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootfs_identity": {
          "description": "`sha256:<hex>` of the rootfs file's bytes.",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "architecture",
        "kernel_identity",
        "rootfs_identity",
        "manifest_version"
      ]
    },
    "LifecycleState": {
      "type": "string",
      "enum": [
        "REQUESTED",
        "PROVISIONING",
        "READY",
        "RUNNING",
        "PAUSED",
        "COMPLETED",
        "FAILED",
        "STOPPING",
        "STOPPED",
        "DESTROYED"
      ]
    },
    "NetworkMode": {
      "description": "Phase 1 network vocabulary: `none` only (spec §18.7, DELTA-015). The enum is\n`non_exhaustive` so adding a mode later is a *minor* contract change that must ship with\nits own semantic contract and adversarial tests.",
      "type": "string",
      "enum": [
        "none"
      ]
    },
    "OperationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]{8,64}$"
    },
    "OperationPhase": {
      "description": "How far a durable operation has progressed. `step` names the *next* privileged step that\nhas been declared (write-ahead intent) — on a crash it tells recovery what may have run.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "accepted"
            }
          },
          "required": [
            "phase"
          ]
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "in_progress"
            },
            "step": {
              "type": "string"
            }
          },
          "required": [
            "phase",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "phase": {
              "type": "string",
              "const": "terminal"
            }
          },
          "required": [
            "phase"
          ]
        }
      ]
    },
    "OperationStatus": {
      "description": "Spec §8.2. `Conflict` and `Rejected` never create durable mutation.",
      "type": "string",
      "enum": [
        "ACCEPTED",
        "IN_PROGRESS",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN",
        "CONFLICT",
        "REJECTED"
      ]
    },
    "OperationType": {
      "type": "string",
      "enum": [
        "sandbox_create",
        "sandbox_start",
        "sandbox_stop",
        "sandbox_destroy",
        "exec",
        "snapshot_create",
        "snapshot_restore",
        "snapshot_delete",
        "policy_reload"
      ]
    },
    "OperationView": {
      "type": "object",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "operation_type": {
          "$ref": "#/$defs/OperationType"
        },
        "phase": {
          "$ref": "#/$defs/OperationPhase"
        },
        "resource_id": {
          "type": "string"
        },
        "result": true,
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/OperationStatus"
        },
        "updated": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "operation_type",
        "status",
        "phase",
        "resource_id",
        "updated"
      ]
    },
    "OutputCapture": {
      "type": "object",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_b64": {
          "description": "Base64 of the kept bytes — binary-safe, and bounded by the run's output budget.",
          "type": "string"
        },
        "kept_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/OutputStatus"
        },
        "total_bytes": {
          "description": "Bytes the workload produced (>= `kept_bytes` when truncated).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "total_bytes",
        "kept_bytes",
        "data_b64"
      ]
    },
    "OutputStatus": {
      "description": "State of one captured stream (spec §18.8).",
      "type": "string",
      "enum": [
        "COMPLETE",
        "TRUNCATED",
        "INCOMPLETE"
      ]
    },
    "PolicyId": {
      "description": "Identity of the policy in force when an operation was admitted (spec §16.7).",
      "type": "object",
      "properties": {
        "digest": {
          "description": "sha256 of the exact bytes that were verified and parsed.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ]
    },
    "ProcessIdentity": {
      "description": "Stronger-than-PID process identity (spec §13.5, DELTA-013).\n\n`(pid, start_time_ticks, boot_id)` is stable for the life of one process and cannot be\nreproduced by a different process that merely reuses the pid.",
      "type": "object",
      "properties": {
        "boot_id": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "int32"
        },
        "start_time_ticks": {
          "description": "Field 22 of /proc/<pid>/stat (clock ticks since boot).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "pid",
        "start_time_ticks",
        "boot_id"
      ]
    },
    "ResourceEvidence": {
      "description": "Per-resource enforcement record (spec §18.10).",
      "type": "object",
      "properties": {
        "action_taken": {
          "type": "string"
        },
        "configured": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "effective": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "mechanism": {
          "description": "The mechanism that actually enforced it — never claim a stronger one than was applied.",
          "type": "string"
        },
        "observed_peak": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "resource": {
          "type": "string"
        },
        "violation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureClass"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resource",
        "action_taken",
        "mechanism"
      ]
    },
    "ResponseBody": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/HostInfo"
            },
            "type": {
              "type": "string",
              "const": "host_info"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/SandboxView"
            },
            "type": {
              "type": "string",
              "const": "sandbox"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SandboxView"
              }
            },
            "type": {
              "type": "string",
              "const": "sandboxes"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/RunResult"
            },
            "type": {
              "type": "string",
              "const": "run"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/SnapshotView"
            },
            "type": {
              "type": "string",
              "const": "snapshot"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SnapshotView"
              }
            },
            "type": {
              "type": "string",
              "const": "snapshots"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "$ref": "#/$defs/OperationView"
            },
            "type": {
              "type": "string",
              "const": "operation"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": true,
            "type": {
              "type": "string",
              "const": "metrics"
            }
          },
          "required": [
            "type",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ack"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "RunId": {
      "type": "string",
      "pattern": "^run-[0-9a-f]{32}$"
    },
    "RunMetrics": {
      "type": "object",
      "properties": {
        "cpu_usage_usec": {
          "description": "Host-cgroup CPU time consumed by the VMM during the run (delta).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "memory_peak_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "wall_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "wall_ms"
      ]
    },
    "RunOutcome": {
      "description": "Terminal classification of one run (spec §8.7). `Running` is observation-only.",
      "type": "string",
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT",
        "UNKNOWN"
      ]
    },
    "RunResult": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          }
        },
        "evidence_status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "image_id": {
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/RunMetrics"
        },
        "note": {
          "description": "Honest note when the outcome is `UNKNOWN`/`FAILED` for infrastructure reasons.",
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "outcome": {
          "$ref": "#/$defs/RunOutcome"
        },
        "policy_id": {
          "$ref": "#/$defs/PolicyId"
        },
        "resource_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceEvidence"
          }
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "sandbox_id": {
          "$ref": "#/$defs/SandboxId"
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "stderr": {
          "$ref": "#/$defs/OutputCapture"
        },
        "stdout": {
          "$ref": "#/$defs/OutputCapture"
        }
      },
      "required": [
        "run_id",
        "operation_id",
        "sandbox_id",
        "generation",
        "outcome",
        "stdout",
        "stderr",
        "metrics",
        "evidence_status",
        "resource_evidence",
        "artifacts",
        "policy_id",
        "image_id"
      ]
    },
    "SandboxId": {
      "type": "string",
      "pattern": "^sbx-[0-9a-f]{32}$"
    },
    "SandboxResources": {
      "description": "What a sandbox is *given*. Immutable for the life of a generation.",
      "type": "object",
      "properties": {
        "disk_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "memory_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "network": {
          "$ref": "#/$defs/NetworkMode"
        },
        "vcpus": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "vcpus",
        "memory_mib",
        "disk_mib",
        "network"
      ]
    },
    "SandboxView": {
      "type": "object",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "$ref": "#/$defs/Generation"
        },
        "image": {
          "$ref": "#/$defs/ImageRef"
        },
        "last_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "Honest caveats attached to this result (e.g. restore uniqueness, retire warnings).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "quarantined": {
          "type": [
            "string",
            "null"
          ]
        },
        "resources": {
          "$ref": "#/$defs/SandboxResources"
        },
        "sandbox_id": {
          "$ref": "#/$defs/SandboxId"
        },
        "security_profile_id": {
          "type": "string"
        },
        "source_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/LifecycleState"
        },
        "updated": {
          "type": "string"
        }
      },
      "required": [
        "sandbox_id",
        "generation",
        "state",
        "resources",
        "image",
        "security_profile_id",
        "updated"
      ]
    },
    "SideEffect": {
      "description": "Whether the failed step may already have changed host state.",
      "oneOf": [
        {
          "description": "Failed before any mutation: safe to report as a definite failure.",
          "type": "string",
          "const": "none"
        },
        {
          "description": "The mutation may or may not have happened. Must be reconciled by observation.",
          "type": "string",
          "const": "possible"
        }
      ]
    },
    "SnapshotId": {
      "type": "string",
      "pattern": "^snp-[0-9a-f]{32}$"
    },
    "SnapshotRef": {
      "type": "object",
      "properties": {
        "snapshot_generation": {
          "$ref": "#/$defs/Generation"
        },
        "snapshot_id": {
          "$ref": "#/$defs/SnapshotId"
        }
      },
      "required": [
        "snapshot_id",
        "snapshot_generation"
      ]
    },
    "SnapshotState": {
      "description": "Snapshot artifact state (spec §11.2, creation half).",
      "type": "string",
      "enum": [
        "REQUESTED",
        "SNAPSHOTTING",
        "VERIFYING",
        "READY",
        "INVALID",
        "DELETED"
      ]
    },
    "SnapshotView": {
      "type": "object",
      "properties": {
        "created": {
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "restore_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "snapshot": {
          "$ref": "#/$defs/SnapshotRef"
        },
        "source_sandbox": {
          "type": [
            "array",
            "null"
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/SandboxId"
            },
            {
              "$ref": "#/$defs/Generation"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/SnapshotState"
        }
      },
      "required": [
        "snapshot",
        "state",
        "size_bytes",
        "restore_count",
        "created"
      ]
    }
  }
}
