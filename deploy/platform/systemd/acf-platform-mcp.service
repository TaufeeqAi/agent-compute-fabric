# ACF developer platform, the agent-protocol edge: the process that reads the bytes of agent hosts.
#
#   /opt/acf-platform/mcp/bin/acf-mcp --config /etc/acf-platform/mcp.yaml
#
# It serves the Model Context Protocol over Streamable HTTP, without sessions: it frames each request,
# sends it to the core as a command over the command socket, and frames the answer. The tool catalogue,
# the credential check and every decision are the core's. It holds no secret but the TLS key of its own
# endpoint, and nothing it writes outlives it: the file system is read-only for it, apart from a private
# and empty /tmp that is discarded when it stops.
#
# It runs from an environment of its own (/opt/acf-platform/mcp) and under an account of its own, so that
# the protocol library it needs is neither on the core's import path nor able to read what the REST edge
# holds.
#
# The core need not be up for this unit to start, and it is not stopped when the core is; see
# acf-platform-rest.service. A start that fails because of the configuration (exit status 2 or 78) is
# not retried.
#
# Deliberately NOT set: PrivateUsers= and DynamicUser=. The core admits this process by the uid the kernel
# reports for it, which must be the fixed account named in the core's configuration (edge.users).

[Unit]
Description=ACF developer platform (agent-protocol edge)
Documentation=https://github.com/OWNER/agent-compute-fabric/blob/main/docs/platform/OPERATIONS.md
Wants=network-online.target acf-platform-core.service
After=network-online.target acf-platform-core.service systemd-tmpfiles-setup.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=acf-mcp
Group=acf-mcp
# The group of the command socket. deploy/platform/sysusers.d/acf-platform.conf makes this account a
# member; naming the group here keeps the unit correct on a machine whose accounts were made by hand.
SupplementaryGroups=acf-command

EnvironmentFile=-/etc/default/acf-platform-mcp
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/acf-platform/mcp/bin/acf-mcp --config /etc/acf-platform/mcp.yaml

KillSignal=SIGTERM
# Longer than mcp.tool_wait (25 s by default): a tool call that waits for its operation is answered
# before the process goes.
TimeoutStopSec=45
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2 78

# ---- What this process may touch ----------------------------------------------------------------
# Nothing that lasts is writable: no ReadWritePaths=, and PrivateTmp= gives the process an empty /tmp
# and /var/tmp of its own that disappear with it. The process keeps no state and no session.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
UMask=0077
# What only the core may hold, and the REST edge's key. The accounts and modes already keep this
# process out; this removes the paths from its view as well.
InaccessiblePaths=-/etc/acf-platform/secrets -/var/lib/acf-platform -/var/lib/acf-platform-journal -/etc/acf-platform/rest

# ---- What this process may do -------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Unix sockets (the command socket) and IP (agent hosts).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# This process may listen on its own port and on no other. MUST name listen.port of mcp.yaml: change
# both together. For a port below 1024 add `AmbientCapabilities=CAP_NET_BIND_SERVICE` and
# `CapabilityBoundingSet=CAP_NET_BIND_SERVICE` in a drop-in.
SocketBindAllow=tcp:8444
SocketBindDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
# A core dump of this process holds the TLS key of the endpoint and credentials in transit.
LimitCORE=0
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
