# ACF developer platform, the REST edge: the process that reads the bytes of REST callers.
#
#   /opt/acf-platform/api/bin/acf-api edge --config /etc/acf-platform/rest.yaml
#
# It terminates TLS, bounds and decodes requests, sends each one to the core as a command over the
# command socket, and encodes the answer. It verifies no credential and decides nothing. It holds no
# secret but the TLS key of its own endpoint, and nothing it writes outlives it: the file system is
# read-only for it, apart from a private and empty /tmp that is discarded when it stops.
#
# The core need not be up for this unit to start, and it is not stopped when the core is: while the core
# restarts, callers get an answer that says the service is unavailable and when to try again, instead of
# a refused connection. That is why the core is wanted, not required.
#
# A start that fails because of the configuration (exit status 2 or 78) is not retried.
#
# Deliberately NOT set: PrivateUsers= and DynamicUser=. The core admits this process by the uid the kernel
# reports for it, which must be the fixed account named in the core's configuration (edge.users).

[Unit]
Description=ACF developer platform (REST edge)
Documentation=https://github.com/OWNER/agent-compute-fabric/blob/main/docs/platform/OPERATIONS.md
Wants=network-online.target acf-platform-core.service
After=network-online.target acf-platform-core.service systemd-tmpfiles-setup.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=acf-rest
Group=acf-rest
# The group of the command socket. deploy/platform/sysusers.d/acf-platform.conf makes this account a
# member; naming the group here keeps the unit correct on a machine whose accounts were made by hand.
SupplementaryGroups=acf-command

EnvironmentFile=-/etc/default/acf-platform-rest
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/acf-platform/api/bin/acf-api edge --config /etc/acf-platform/rest.yaml

KillSignal=SIGTERM
# Longer than limits.public_wait_max (30 s by default): a request that waits for its operation is
# answered before the process goes.
TimeoutStopSec=45
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=2 78

# ---- What this process may touch ----------------------------------------------------------------
# Nothing that lasts is writable: no ReadWritePaths=, and PrivateTmp= gives the process an empty /tmp
# and /var/tmp of its own that disappear with it. The process keeps no state: every limit that concerns
# a principal or a project is kept in the core.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
UMask=0077
# What only the core may hold. The accounts and modes already keep this process out; this removes the
# paths from its view as well, so that a mistake in a mode is not enough.
InaccessiblePaths=-/etc/acf-platform/secrets -/var/lib/acf-platform -/var/lib/acf-platform-journal -/etc/acf-platform/mcp

# ---- What this process may do -------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Unix sockets (the command socket) and IP (callers).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# This process may listen on its own port and on no other. MUST name listen.port of rest.yaml: change
# both together. For a port below 1024 add `AmbientCapabilities=CAP_NET_BIND_SERVICE` and
# `CapabilityBoundingSet=CAP_NET_BIND_SERVICE` in a drop-in.
SocketBindAllow=tcp:8443
SocketBindDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
# A core dump of this process holds the TLS key of the endpoint and credentials in transit.
LimitCORE=0
# Above limits.edge_max_connections (1024 by default) plus the connections to the core.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
