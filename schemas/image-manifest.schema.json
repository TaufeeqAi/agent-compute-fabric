{
  "$defs": {
    "FileEntry": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hex sha256.",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "sha256",
        "size"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "type": "string"
    },
    "boot_args": {
      "description": "Overrides the host default boot args. Part of the image identity.",
      "type": [
        "string",
        "null"
      ]
    },
    "guest_agent_version": {
      "type": "string"
    },
    "kernel": {
      "$ref": "#/$defs/FileEntry"
    },
    "name": {
      "type": "string"
    },
    "provenance": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootfs": {
      "$ref": "#/$defs/FileEntry"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "name",
    "architecture",
    "kernel",
    "rootfs",
    "guest_agent_version"
  ],
  "title": "ImageManifest",
  "type": "object"
}
