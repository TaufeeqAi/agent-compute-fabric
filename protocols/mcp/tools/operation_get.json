{
  "name": "operation_get",
  "title": "Read an operation",
  "description": "Read an operation by identifier, optionally waiting a bounded time for it to end. A result with `replayed: true` reports work that already existed and started nothing new. An operation in state UNKNOWN, or an error with code OUTCOME_LOST, means the outcome is not known: inspect the sandbox before acting again, and do not repeat the call blindly.",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "operation_id": {
        "pattern": "^[A-Za-z0-9-]{8,64}$",
        "title": "Operation Id",
        "type": "string"
      },
      "wait_seconds": {
        "anyOf": [
          {
            "maximum": 3600,
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Wait this long for the operation to end.",
        "title": "Wait Seconds"
      }
    },
    "required": [
      "operation_id"
    ],
    "title": "OperationGetInput",
    "type": "object"
  },
